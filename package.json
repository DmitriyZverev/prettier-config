{
  "name": "@dmitriyzverev/prettier-config",
  "version": "3.0.1",
  "description": "A configuration used in projects within the \"@dmitriyzverev\" scope",
  "homepage": "https://github.com/DmitriyZverev/prettier-config",
  "bugs": {
    "url": "https://github.com/DmitriyZverev/prettier-config/issues",
    "email": "opensource@dmitriyzverev.ru"
  },
  "license": "MIT",
  "author": {
    "name": "Dmitriy Zverev",
    "email": "opensource@dmitriyzverev.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitriyZverev/prettier-config.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "build": "rm -rf .package && npx tsc --outDir .package && cp package.json LICENSE README.md .package",
    "formatter:fix": "npx prettier --write \"**/*.{ts,js,json,yml,md}\"",
    "formatter:check": "npx prettier --check \"**/*.{ts,js,json,yml,md}\""
  },
  "peerDependencies": {
    "prettier": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@dmitriyzverev/prettier-config": "2.0.0",
    "@dmitriyzverev/typescript-config": "1.1.1",
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
